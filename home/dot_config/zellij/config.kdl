keybinds clear-defaults=true {
    //{{{ keybinds
    // Meh PageUp/PageDown mode-cycle bindings repeat in every mode below.
    // keymap-ref: zellij-mode-cycle
    normal {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-normal" {
                floating true
                move_to_focused_tab true
                title "NORMAL"
            }
        }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "tmux"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "locked"; }
    }
    locked {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-locked" {
                floating true
                move_to_focused_tab true
                title "LOCKED"
            }
        }
        bind "Ctrl Alt Shift g" { SwitchToMode "normal"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "normal"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "resize"; }
    }
    // keymap-ref: zellij-pane-mode
    pane {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-pane" {
                floating true
                move_to_focused_tab true
                title "PANE"
            }
        }
        bind "c" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "d" { NewPane "down"; SwitchToMode "normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "h" { MoveFocus "left"; }
        bind "i" { TogglePanePinned; SwitchToMode "normal"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocus "right"; }
        bind "n" { NewPane; SwitchToMode "normal"; }
        bind "p" { SwitchFocus; }
        bind "r" { NewPane "right"; SwitchToMode "normal"; }
        bind "s" { NewPane "stacked"; SwitchToMode "normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "normal"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "resize"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "tab"; }
    }
    // keymap-ref: zellij-tab-mode
    tab {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-tab" {
                floating true
                move_to_focused_tab true
                title "TAB"
            }
        }
        bind "left" { GoToPreviousTab; }
        bind "down" { GoToNextTab; }
        bind "up" { GoToPreviousTab; }
        bind "right" { GoToNextTab; }
        bind "1" { GoToTab 1; SwitchToMode "normal"; }
        bind "2" { GoToTab 2; SwitchToMode "normal"; }
        bind "3" { GoToTab 3; SwitchToMode "normal"; }
        bind "4" { GoToTab 4; SwitchToMode "normal"; }
        bind "5" { GoToTab 5; SwitchToMode "normal"; }
        bind "6" { GoToTab 6; SwitchToMode "normal"; }
        bind "7" { GoToTab 7; SwitchToMode "normal"; }
        bind "8" { GoToTab 8; SwitchToMode "normal"; }
        bind "9" { GoToTab 9; SwitchToMode "normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "normal"; }
        bind "b" { BreakPane; SwitchToMode "normal"; }
        bind "e" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "h" { GoToPreviousTab; }
        bind "j" { GoToNextTab; }
        bind "k" { GoToPreviousTab; }
        bind "l" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "normal"; }
        bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "normal"; }
        bind "t" { NewTab; SwitchToMode "normal"; }
        bind "Ctrl Alt Shift t" { SwitchToMode "normal"; }
        bind "x" { CloseTab; SwitchToMode "normal"; }
        bind "tab" { ToggleTab; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "pane"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "scroll"; }
    }
    // keymap-ref: zellij-resize-mode
    resize {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-resize" {
                floating true
                move_to_focused_tab true
                title "RESIZE"
            }
        }
        bind "left" { Resize "Increase left"; }
        bind "down" { Resize "Increase down"; }
        bind "up" { Resize "Increase up"; }
        bind "right" { Resize "Increase right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "=" { Resize "Increase"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "h" { Resize "Increase left"; }
        bind "j" { Resize "Increase down"; }
        bind "k" { Resize "Increase up"; }
        bind "l" { Resize "Increase right"; }
        bind "Ctrl Alt Shift n" { SwitchToMode "normal"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "locked"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "pane"; }
    }
    // keymap-ref: zellij-move-mode
    move {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-move" {
                floating true
                move_to_focused_tab true
                title "MOVE"
            }
        }
        bind "left" { MovePane "left"; }
        bind "down" { MovePane "down"; }
        bind "up" { MovePane "up"; }
        bind "right" { MovePane "right"; }
        bind "h" { MovePane "left"; }
        bind "Ctrl Alt Shift h" { SwitchToMode "normal"; }
        bind "j" { MovePane "down"; }
        bind "k" { MovePane "up"; }
        bind "l" { MovePane "right"; }
        bind "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "tab" { MovePane; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "session"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "prompt"; }
    }
    // keymap-ref: zellij-scroll-search-modes
    scroll {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-scroll" {
                floating true
                move_to_focused_tab true
                title "SCROLL"
            }
        }
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        // Zellij has no keyboard selection cursor, so "v" hands the scrollback to
        // nvim, where real visual mode and the rest of the vim motions live.
        bind "v" { EditScrollback; SwitchToMode "normal"; }
        bind "y" { Copy; SwitchToMode "normal"; }
        bind "Y" { CopyLastCommandOutput; SwitchToMode "normal"; }
        bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl Alt Shift s" { SwitchToMode "normal"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "tab"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "entersearch"; }
    }
    search {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-search" {
                floating true
                move_to_focused_tab true
                title "SEARCH"
            }
        }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "n" { Search "down"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "p" { Search "up"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "entersearch"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "renametab"; }
    }
    // keymap-ref: zellij-session-mode
    session {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-session" {
                floating true
                move_to_focused_tab true
                title "SESSION"
            }
        }
        bind "a" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "renamepane"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "move"; }
    }
    shared_among "normal" "locked" {
        // keymap-ref: zellij-quick-pane-tab
        bind "Super Shift ]" { MoveFocusOrTab "right"; }
        bind "Super Shift [" { MoveFocusOrTab "left"; }
        bind "Super h" { MoveFocusOrTab "left"; }
        bind "Super j" { MoveFocus "down"; }
        bind "Super k" { MoveFocus "up"; }
        bind "Super l" { MoveFocusOrTab "right"; }
        // keymap-ref: zellij-quick-resize
        bind "Ctrl Alt Shift  +" { Resize "Increase"; }
        bind "Ctrl Alt Shift  -" { Resize "Decrease"; }
        bind "Ctrl Alt Shift  =" { Resize "Increase"; }
    }
    shared_except "locked" {
        bind "Alt p" { TogglePaneInGroup; }
        bind "Alt Shift p" { ToggleGroupMarking; }
        unbind "Alt Left"
        unbind "Alt Right"
        // keymap-ref: zellij-new-tab
        bind "Super t" { NewTab; SwitchToMode "normal"; }
    }
    // keymap-ref: zellij-mode-entry
    shared_except "locked" "entersearch" "renametab" "renamepane" "move" "prompt" "tmux" {
        bind "Ctrl Alt Shift h" { SwitchToMode "move"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" "prompt" "tmux" {
        bind "Ctrl Alt Shift g" { SwitchToMode "locked"; }
        bind "Ctrl Alt Shift q" { Quit; }
        bind "Alt y" { EditScrollback; }
    }
    shared_except "locked" "scroll" "search" "tmux" {
        bind "Ctrl b" { SwitchToMode "tmux"; }
    }
    shared_except "locked" "scroll" "entersearch" "renametab" "renamepane" "prompt" "tmux" {
        bind "Ctrl Alt Shift s" { SwitchToMode "scroll"; }
    }
    shared_except "locked" "tab" "entersearch" "renametab" "renamepane" "prompt" "tmux" {
        bind "Ctrl Alt Shift t" { SwitchToMode "tab"; }
    }
    shared_except "locked" "resize" "entersearch" "renametab" "renamepane" "prompt" "tmux" {
        bind "Ctrl Alt Shift n" { SwitchToMode "resize"; }
    }
    // keymap-ref: zellij-alt-quick-actions
    shared_except "normal" "locked" {
        bind "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt i" { MoveTab "left"; }
        bind "Alt n" { NewPane; }
        bind "Alt o" { MoveTab "right"; }
    }
    shared_except "normal" "locked" "entersearch" {
        bind "enter" { SwitchToMode "normal"; }
    }
    shared_except "normal" "locked" "entersearch" "renametab" "renamepane" {
        bind "esc" { SwitchToMode "normal"; }
    }
    shared_among "pane" "tmux" {
        bind "x" { CloseFocus; SwitchToMode "normal"; }
    }
    // keymap-ref: zellij-scroll-navigation
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "left" { PageScrollUp; }
        bind "down" { ScrollDown; }
        bind "up" { ScrollUp; }
        bind "right" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "d" { HalfPageScrollDown; }
        bind "Ctrl f" { PageScrollDown; }
        bind "h" { PageScrollUp; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "l" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        // Prompt-to-prompt jumping and command selection need OSC 133 marks from
        // the shell; see the starship block in assets/shell-environment/init.
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "scroll"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "search"; }
    }
    shared_among "entersearch" "renametab" "renamepane" "prompt" "tmux" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl h" { SwitchToMode "move"; }
        bind "Ctrl n" { SwitchToMode "resize"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl q" { Quit; }
        bind "Ctrl s" { SwitchToMode "scroll"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
    }
    // keymap-ref: zellij-rename-modes
    renametab {
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "search"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "renamepane"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "normal"; }
    }
    renamepane {
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "renametab"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "session"; }
    }
    shared_among "session" "tmux" {
        bind "d" { Detach; }
    }
    // keymap-ref: zellij-tmux-mode
    tmux {
        bind "Super /" {
            LaunchOrFocusPlugin "forgot-tmux" {
                floating true
                move_to_focused_tab true
                title "TMUX"
            }
        }
        bind "left" { MoveFocus "left"; SwitchToMode "normal"; }
        bind "down" { MoveFocus "down"; SwitchToMode "normal"; }
        bind "up" { MoveFocus "up"; SwitchToMode "normal"; }
        bind "right" { MoveFocus "right"; SwitchToMode "normal"; }
        bind "space" { NextSwapLayout; }
        bind "\"" { NewPane "down"; SwitchToMode "normal"; }
        bind "%" { NewPane "right"; SwitchToMode "normal"; }
        bind "," { SwitchToMode "renametab"; }
        bind "[" { SwitchToMode "scroll"; }
        bind "Ctrl b" { Write 2; SwitchToMode "normal"; }
        bind "c" { NewTab; SwitchToMode "normal"; }
        bind "h" { MoveFocus "left"; SwitchToMode "normal"; }
        bind "j" { MoveFocus "down"; SwitchToMode "normal"; }
        bind "k" { MoveFocus "up"; SwitchToMode "normal"; }
        bind "l" { MoveFocus "right"; SwitchToMode "normal"; }
        bind "n" { GoToNextTab; SwitchToMode "normal"; }
        bind "o" { FocusNextPane; }
        bind "p" { GoToPreviousTab; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "prompt"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "normal"; }
    }
    prompt {
        bind "Ctrl Alt Shift PageUp" { SwitchToMode "move"; }
        bind "Ctrl Alt Shift PageDown" { SwitchToMode "tmux"; }
    }
    // }}}
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    // {{{ plugins
    about location="zellij:about"
    // keymap-ref: zellij-keybind-tooltip
    forgot-normal location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close help" "Esc / Ctrl+C"
        "cycle to locked mode" "Meh+PageDown"
        "cycle to tmux mode" "Meh+PageUp"
        "edit scrollback" "Alt+Y"
        "focus down" "Cmd+J"
        "focus left / previous tab" "Cmd+H"
        "focus right / next tab" "Cmd+L"
        "focus up" "Cmd+K"
        "lock" "Meh+G"
        "move mode" "Meh+H"
        "new tab" "Cmd+T"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "previous / next tab" "Cmd+Shift+[ / ]"
        "quit" "Meh+Q"
        "resize" "Meh+- / ="
        "resize mode" "Meh+N"
        "scroll mode" "Meh+S"
        "search help" "type"
        "tab mode" "Meh+T"
        "tmux mode" "Ctrl+B"
    }
    forgot-locked location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close help" "Esc / Ctrl+C"
        "cycle to normal mode" "Meh+PageUp"
        "cycle to resize mode" "Meh+PageDown"
        "focus down" "Cmd+J"
        "focus left / previous tab" "Cmd+H"
        "focus right / next tab" "Cmd+L"
        "focus up" "Cmd+K"
        "previous / next tab" "Cmd+Shift+[ / ]"
        "resize" "Meh+- / ="
        "search help" "type"
        "unlock" "Meh+G"
    }
    forgot-pane location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close focused pane" "X"
        "close help" "Esc / Ctrl+C"
        "cycle to resize / tab mode" "Meh+PageUp / PageDown"
        "edit scrollback" "Alt+Y"
        "focus pane" "H / J / K / L"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+H / N / S / T; Ctrl+B"
        "new pane" "N"
        "new pane down / right / stacked" "D / R / S"
        "new tab" "Cmd+T"
        "normal mode" "Enter / Esc"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "rename pane" "C"
        "search help" "type"
        "switch focus" "P"
        "toggle floating panes" "W"
        "toggle fullscreen" "F"
        "toggle pane embed / floating" "E"
        "toggle pane pinned" "I"
        "toggle pane frames" "Z"
    }
    forgot-tab location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "break pane" "B"
        "break pane left / right" "[ / ]"
        "close help" "Esc / Ctrl+C"
        "close tab" "X"
        "cycle to pane / scroll mode" "Meh+PageUp / PageDown"
        "edit scrollback" "Alt+Y"
        "go to tab" "1-9"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+H / N / S; Ctrl+B"
        "move between tabs" "arrows / H / J / K / L"
        "new tab" "N / T / Cmd+T"
        "normal mode" "Enter / Esc / Meh+T"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "rename tab" "E / R"
        "search help" "type"
        "toggle active sync" "S"
        "toggle previous tab" "Tab"
    }
    forgot-resize location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close help" "Esc / Ctrl+C"
        "cycle to locked / pane mode" "Meh+PageUp / PageDown"
        "decrease all" "-"
        "decrease direction" "Shift+H / J / K / L"
        "edit scrollback" "Alt+Y"
        "increase all" "+ / ="
        "increase direction" "arrows / H / J / K / L"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+H / S / T; Ctrl+B"
        "new tab" "Cmd+T"
        "normal mode" "Enter / Esc / Meh+N"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "search help" "type"
    }
    forgot-move location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close help" "Esc / Ctrl+C"
        "cycle to session / prompt mode" "Meh+PageUp / PageDown"
        "edit scrollback" "Alt+Y"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+N / S / T; Ctrl+B"
        "move pane" "arrows / H / J / K / L / N / Tab"
        "move pane backwards" "P"
        "new tab" "Cmd+T"
        "normal mode" "Enter / Esc / Meh+H"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "search help" "type"
    }
    forgot-scroll location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close help" "Esc / Ctrl+C"
        "copy" "Y"
        "copy last command output" "Shift+Y"
        "cycle to tab / enter-search mode" "Meh+PageUp / PageDown"
        "edit scrollback" "E / V / Alt+Y"
        "half-page down / up" "D / U / Ctrl+D / Ctrl+U"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+H / N / T"
        "new tab" "Cmd+T"
        "normal mode" "Enter / Esc / Ctrl+C"
        "next / previous prompt" "] / ["
        "page down / up" "PageDown / PageUp / Ctrl+F / Ctrl+B / L / H"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "scroll down / up" "Down / Up / J / K"
        "search" "S"
        "search help" "type"
        "select command" "M"
        "top / bottom" "G / Shift+G"
    }
    forgot-search location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close help" "Esc / Ctrl+C"
        "cycle to enter-search / rename-tab mode" "Meh+PageUp / PageDown"
        "edit scrollback" "Alt+Y"
        "half-page down / up" "D / U / Ctrl+D / Ctrl+U"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+H / N / S / T"
        "new tab" "Cmd+T"
        "next / previous match" "N / P"
        "normal mode" "Enter / Esc / Ctrl+C"
        "next / previous prompt" "] / ["
        "page down / up" "PageDown / PageUp / Ctrl+F / Ctrl+B / L / H"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "scroll down / up" "Down / Up / J / K"
        "search help" "type"
        "select command" "M"
        "toggle case / whole word / wrap" "C / O / W"
        "top / bottom" "G / Shift+G"
    }
    forgot-session location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "about" "A"
        "close help" "Esc / Ctrl+C"
        "configuration" "C"
        "cycle to rename-pane / move mode" "Meh+PageUp / PageDown"
        "detach" "D"
        "edit scrollback" "Alt+Y"
        "lock / quit" "Meh+G / Meh+Q"
        "mode shortcuts" "Meh+H / N / S / T; Ctrl+B"
        "new tab" "Cmd+T"
        "normal mode" "Enter / Esc"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "plugin manager" "P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "search help" "type"
        "session manager" "W"
        "share" "S"
    }
    forgot-tmux location="file:./plugins/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "false"
        "close focused pane" "X"
        "close help" "Esc / Ctrl+C"
        "cycle to prompt / normal mode" "Meh+PageUp / PageDown"
        "detach" "D"
        "focus pane" "arrows / H / J / K / L"
        "focus next pane" "O"
        "new pane down / right" "\" / %"
        "new tab" "C / Cmd+T"
        "next / previous tab" "N / P"
        "normal mode" "Enter / Esc"
        "pane grouping" "Alt+P / Alt+Shift+P"
        "quick actions" "Alt+- / = / [ / ] / F / I / N / O"
        "rename tab" ","
        "scroll mode" "["
        "search help" "type"
        "send Ctrl+B" "Ctrl+B"
        "toggle fullscreen" "Z"
        "swap layout" "Space"
    }
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    // }}}
}

// Plugins to load in the background when a new session starts
// eg. "file:/path/to/my-plugin.wasm"
// eg. "https://example.com/my-plugin.wasm"
load_plugins {
    // {{{ load plugins
    "file:./plugins/zjframes.wasm" {
        hide_frame_for_single_pane       "true"
        hide_frame_except_for_search     "true"
        hide_frame_except_for_scroll     "true"
        hide_frame_except_for_fullscreen "true"
    }
    // }}}
}

web_client {
    // {{{ web_client 
    font "monospace"
    // }}}
}

theme "kanso-ink"
default_layout "bsl"
pane_frames false
copy_command "pbcopy"                     // osx
session_name "bsl "
attach_to_session true
scrollback_lines_to_serialize 100000
show_startup_tips false
keybinds {
}

