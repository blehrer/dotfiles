theme = light:kanso-pearl,dark:kanso-ink

keybind = clear
keybind = super+shift+,=reload_config
keybind = unconsumed:f5=reload_config
keybind = super+,=open_config
keybind = copy=copy_to_clipboard:mixed
keybind = paste=paste_from_clipboard
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+==increase_font_size:1
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size
keybind = super+alt+f=increase_font_size:10
keybind = super+shift+alt+f=decrease_font_size:10
keybind = super+ctrl+shift+j=write_screen_file:copy,plain
keybind = super+shift+j=write_screen_file:paste,plain
keybind = super+alt+shift+j=write_screen_file:open,plain
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = shift+page_up=adjust_selection:page_up
keybind = shift+page_down=adjust_selection:page_down
keybind = shift+home=adjust_selection:home
keybind = shift+end=adjust_selection:end
# No Ghostty tabs — Zellij owns tabs. Unbind literal + physical (macOS keeps both).
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = super+shift+bracket_left=unbind
keybind = super+shift+bracket_right=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+digit_1=unbind
keybind = super+1=unbind
keybind = super+digit_2=unbind
keybind = super+2=unbind
keybind = super+digit_3=unbind
keybind = super+3=unbind
keybind = super+digit_4=unbind
keybind = super+4=unbind
keybind = super+digit_5=unbind
keybind = super+5=unbind
keybind = super+digit_6=unbind
keybind = super+6=unbind
keybind = super+digit_7=unbind
keybind = super+7=unbind
keybind = super+digit_8=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+alt+w=unbind
keybind = super+enter=toggle_fullscreen
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+p=toggle_command_palette
keybind = super+q=quit
keybind = super+h=csi:104;9u
keybind = super+j=csi:106;9u
keybind = super+k=csi:107;9u
keybind = super+l=csi:108;9u
# Zellij: kitty CSI (Super = ;9u, Super+Shift = ;10u)
keybind = super+/=csi:47;9u
keybind = super+t=csi:116;9u
keybind = super+shift+[=csi:91;10u
keybind = super+shift+]=csi:93;10u
keybind = super+shift+left_bracket=csi:91;10u
keybind = super+shift+right_bracket=csi:93;10u
keybind = super+a=select_all
keybind = super+shift+t=undo
keybind = super+z=undo
keybind = super+shift+z=redo
keybind = super+home=scroll_to_top
keybind = super+end=scroll_to_bottom
keybind = super+page_up=scroll_page_up
keybind = super+page_down=scroll_page_down
keybind = super+shift+arrow_up=jump_to_prompt:-1
keybind = super+shift+arrow_down=jump_to_prompt:1
keybind = super+n=new_window
keybind = super+w=close_surface
keybind = super+shift+w=close_window
keybind = super+alt+shift+w=close_all_windows
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+ctrl+arrow_up=resize_split:up,10
keybind = super+ctrl+arrow_down=resize_split:down,10
keybind = super+ctrl+arrow_left=resize_split:left,10
keybind = super+ctrl+arrow_right=resize_split:right,10
keybind = super+ctrl+==equalize_splits
keybind = super+arrow_up=jump_to_prompt:-1
keybind = super+arrow_down=jump_to_prompt:1
keybind = super+f=start_search
keybind = super+e=search_selection
keybind = super+shift+f=end_search
keybind = super+g=navigate_search:next
keybind = super+shift+g=navigate_search:previous
keybind = super+alt+i=inspector:toggle
keybind = super+ctrl+f=toggle_fullscreen
keybind = super+shift+v=paste_from_selection
keybind = super+arrow_right=text:\\x05
keybind = super+arrow_left=text:\\x01
keybind = super+backspace=text:\\x15
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f

macos-titlebar-style = hidden
copy-on-select = clipboard
window-padding-balance = true
window-padding-x = 10
font-family = GeistMono Nerd Font
font-size = 16